generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// --- better-auth ------------------------------------------------------------
// Core tables for better-auth. Field names and types must stay in sync with
// the auth config in src/lib/auth.ts; re-check them after enabling plugins or
// social providers.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  settings      UserSettings?
  headerWidgets HeaderWidget[]
  pages         Page[]
  widgets       DashboardWidget[]
  notes         Note[]
  articles      Article[]
  tableColumns  TableColumn[]
  tableEntries  TableEntry[]
  documents     Document[]
  pageRecords   PageRecord[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@map("verification")
}


// --- User Settings ----------------------------------------------------------------
// Per-user preferences kept out of the better-auth user row: one row per user,
// created on first write. `themeHue` is the hue (0-359) the Mantine primary color is
// generated from, null meaning the app default.

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeHue  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}


// --- Header Widgets ---------------------------------------------------------------

model HeaderWidget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  label     String
  position  Int      @default(0)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, position])
  @@map("header_widget")
}


// --- Pages ---------------------------------------------------------------------------

model Page {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  slug      String
  position  Int      @default(0)
  parentId  String?
  parent    Page?    @relation("PageToPage", fields: [parentId], references: [id], onDelete: Cascade)
  children  Page[]   @relation("PageToPage")
  type      String?
  config    Json?
  widgets   DashboardWidget[]
  notes     Note[]
  article   Article?
  tableColumns TableColumn[]
  tableEntries TableEntry[]
  documents Document[]
  pageRecords PageRecord[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
  @@unique([parentId, position])
  @@index([userId, position])
  @@map("page")
}


// --- Dashboard Widgets --------------------------------------------------------------
// One row per widget instance, one row per record a widget owns. Widget types are
// not modelled here: a widget declares its own fields in its module and both
// `config` and `WidgetRecord.data` hold a flat map of scalars keyed by field name,
// so a new widget type never needs a schema change.
//
// `pageId` is the grid the instance belongs to: null is the main dashboard, a page
// id is that page's own dashboard. Deleting the page deletes its widgets.

model DashboardWidget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId    String?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String
  label     String
  config    Json
  x         Int      @default(0)
  y         Int      @default(0)
  w         Int      @default(4)
  h         Int      @default(4)
  records   WidgetRecord[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, pageId])
  @@map("dashboard_widget")
}

// --- Notes -------------------------------------------------------------------------
// One row per note on a notes page. `content` is the editor's HTML, images included as
// inline data URLs, so a note is self-contained and needs no file storage. x/y/w/h are
// the same grid units the dashboard uses.

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title     String
  content   String   @default("")
  x         Int      @default(0)
  y         Int      @default(0)
  w         Int      @default(4)
  h         Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, pageId])
  @@map("note")
}

// --- Articles ----------------------------------------------------------------------
// One row per article page, so `pageId` is unique as well as required. `content` is the
// editor's HTML, images included as inline data URLs, the same self-contained shape a
// note uses. The Markdown editing mode converts to and from this HTML and is not stored.

model Article {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId    String   @unique
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("article")
}

model WidgetRecord {
  id         String          @id @default(cuid())
  widgetId   String
  widget     DashboardWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  collection String          @default("default")
  position   Int             @default(0)
  sortKey    String?
  data       Json
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([widgetId, collection, sortKey])
  @@index([widgetId, collection, position])
  @@map("widget_record")
}
// --- Table pages -------------------------------------------------------------------
// A table page's columns are user data, not code: the user adds them at runtime and
// each one declares a field kind the shared widget field system already renders. One
// row per column, one row per entry, both scoped to the page and deleted with it.
//
// `TableEntry.data` is a flat map of scalars keyed by **column id**, so renaming a
// column keeps its values. `position` carries the user's order and has no unique
// constraint: reordering writes every row once in a transaction.

model TableColumn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  label     String
  kind      String
  position  Int      @default(0)
  required  Boolean  @default(false)
  options   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, pageId, position])
  @@map("table_column")
}

model TableEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, pageId, position])
  @@map("table_entry")
}

// --- Document pages ----------------------------------------------------------------
// One row per node of a documents page's tree, folders and files alike, told apart by
// `kind`. `parentId` nests a node inside a folder and is null at the page's root;
// `pageId` is carried on every node, nested ones included, so one indexed query loads
// a whole tree. Both foreign keys cascade, so deleting a folder deletes its subtree.
//
// A file's bytes live in `content` as a BLOB and are never part of a tree query: only
// the download route selects that column. There is no `position` — the tree is sorted
// folders-first by name, the way a file manager does it.

model Document {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId    String
  page      Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Document?  @relation("DocumentToDocument", fields: [parentId], references: [id], onDelete: Cascade)
  children  Document[] @relation("DocumentToDocument")
  kind      String
  name      String
  mimeType  String?
  size      Int        @default(0)
  content   Bytes?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, pageId, parentId])
  @@map("document")
}

// --- Page records -------------------------------------------------------------------
// The generic per-page row store, the counterpart of `widget_record`: a page type that
// needs rows of its own uses this instead of adding a table, so a new page type never
// needs a schema change. `collection` separates the row sets one page type owns (a
// kanban page keeps its lanes and its cards in two), and `data` is the same flat map of
// scalars a widget record holds, keyed by field name.
//
// `position` carries a user-arranged order and `sortKey` a derived one; neither is
// unique, so a reorder writes every row once in a transaction. Rows are scoped by page
// and cascade with it.

model PageRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  collection String   @default("default")
  position   Int      @default(0)
  sortKey    String?
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, pageId, collection, position])
  @@index([userId, pageId, collection, sortKey])
  @@map("page_record")
}
