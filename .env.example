# SQLite database file.
# - Local dev: a relative path is fine.
# - Docker (see docker-compose.yml): must be inside the mounted volume,
#   i.e. DATABASE_URL="file:/app/data/dashb.db", or every restart starts
#   from an empty database.
DATABASE_URL="file:./dev.db"

# Signing secret for sessions. Generate with:
#   pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=""

# Public base URL of the app, scheme included. Better Auth builds its
# callback URLs from this and marks the session cookie `Secure` whenever it
# starts with https, so this is what makes login work behind Caddy - there
# is no separate cookie flag to set. It must be the URL in the browser's
# address bar, not the container's own address.
BETTER_AUTH_URL="http://localhost:3000"

# Origins allowed to post to the auth endpoints, comma-separated. Normally
# the same single value as BETTER_AUTH_URL.
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

PORT=3000

# Nightly demo reset. Leave this unset on any instance holding real data: when
# it is set, every account and everything in it is deleted at this time, daily.
# "HH:MM" on a 24-hour clock, in the container's timezone - set TZ below if you
# do not want UTC. Unset or malformed means no reset, and the server logs the
# next one at startup, so the log says whether it took.
DEMO_RESET_AT="03:00"

# TZ="Europe/Zurich"
