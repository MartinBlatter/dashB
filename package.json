{
    "name": "dashb",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "vite dev --port 3000",
        "generate-routes": "vite build",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint",
        "format": "prettier --write . && eslint --fix",
        "check": "prettier --check .",
        "db:generate": "dotenv -e .env.local -- prisma generate",
        "db:push": "dotenv -e .env.local -- prisma db push",
        "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
        "db:studio": "dotenv -e .env.local -- prisma studio",
        "prepare": "husky"
    },
    "lint-staged": {
        "*": "prettier --check --ignore-unknown",
        "*.{ts,tsx,js,jsx,mjs,cjs}": "eslint --no-warn-ignored"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@mantine/core": "9.7.4",
        "@mantine/dates": "9.7.4",
        "@mantine/hooks": "9.7.4",
        "@mantine/schedule": "9.7.4",
        "@phosphor-icons/react": "^2.1.10",
        "@prisma/adapter-better-sqlite3": "^7.4.2",
        "@prisma/client": "^7.4.2",
        "@t3-oss/env-core": "^0.13.10",
        "@tanstack/match-sorter-utils": "9.2.6",
        "@tanstack/react-devtools": "0.10.14",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-query": "5.105.3",
        "@tanstack/react-query-devtools": "5.105.3",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-router-devtools": "1.167.2",
        "@tanstack/react-router-ssr-query": "1.167.3",
        "@tanstack/react-start": "1.169.4",
        "@tanstack/react-store": "0.11.2",
        "@tanstack/react-table": "9.3.1",
        "@tanstack/store": "0.11.2",
        "better-auth": "^1.5.3",
        "dayjs": "^1.11.23",
        "ical.js": "^2.2.1",
        "nitro": "3.0.260610-beta",
        "prisma": "^7.4.2",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-grid-layout": "^2.3.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@inlang/paraglide-js": "^2.13.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tanstack/devtools-event-client": "0.5.1",
        "@tanstack/devtools-vite": "0.8.6",
        "@tanstack/eslint-config": "0.4.0",
        "@types/node": "^22.10.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "dotenv-cli": "^11.0.0",
        "eslint": "10.0.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "postcss": "^8.5.32",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^3.8.1",
        "prettier-eslint": "^17.1.2",
        "typescript": "^6.0.2",
        "vite": "^8.0.0"
    },
