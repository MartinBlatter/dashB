{
    "bundler": "vite",
    "projectName": "dashb",
    "mode": "file-router",
    "typescript": true,
    "packageManager": "pnpm",
    "includeExamples": true,
    "tailwind": false,
    "projectPreset": "default",
    "routerOnly": false,
    "addOnOptions": {
        "prisma": {
            "database": "sqlite"
        }
    },
    "git": false,
    "install": true,
    "intent": true,
    "version": 1,
    "framework": "react",
    "chosenAddOns": [
        "eslint",
        "nitro",
        "prisma",
        "compiler",
        "form",
        "paraglide",
        "t3env",
        "table",
        "better-auth",
        "store",
        "tanstack-query"
    ]
}
